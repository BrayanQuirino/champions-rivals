{
  "schemaVersion": 2,
  "methodology": {
    "origin": "Taxonomía editorial de Champions Rivals; no es una clasificación oficial de EA Sports FC o Football Manager.",
    "scale": "0 a 100",
    "sampleMinimumForStableArchetype": 8,
    "requiredDimensions": 6,
    "notes": "Siempre se asigna el patrón más cercano cuando hay partidos; con menos de 8 juegos detallados o ajuste ambiguo se indica provisional. Sin partidos no se infiere estilo. Cada eje proviene de estadísticas disponibles, sin imputar valores ausentes."
  },
  "dimensions": [
    {
      "id": "ataque",
      "label": "Ataque",
      "source": "shots, expectedGoals",
      "method": "55% participación de tiros, 45% participación de xG frente al rival"
    },
    {
      "id": "defensa",
      "label": "Defensa",
      "source": "shots, successfulTackles, recoveries",
      "method": "45% limitación de tiros rivales, 25% entradas exitosas relativas, 30% recuperaciones relativas"
    },
    {
      "id": "posesion",
      "label": "Posesión",
      "source": "possession",
      "method": "porcentaje registrado"
    },
    {
      "id": "precision",
      "label": "Precisión",
      "source": "passAccuracy, shotAccuracy",
      "method": "70% precisión de pases y 30% precisión de tiros"
    },
    {
      "id": "creacion",
      "label": "Creación",
      "source": "expectedGoals, lineBreakAttempts",
      "method": "65% participación de xG y 35% rupturas de línea relativas"
    },
    {
      "id": "efectividad",
      "label": "Efectividad",
      "source": "goals, shots, shotAccuracy",
      "method": "65% conversión de goles/tiros normalizada al 30%, 35% precisión de tiros"
    }
  ],
