{
  "schemaVersion": 1,
  "methodology": {
    "origin": "Taxonomía editorial de Champions Rivals; no es una clasificación oficial de EA Sports FC o Football Manager.",
    "scale": "0 a 100",
    "sampleMinimumForStableArchetype": 3,
    "requiredDimensions": 4,
    "notes": "Los arquetipos son perfiles hipotéticos de referencia. Las comparaciones son indicativas, no causalidad táctica. No inferimos presión alta ni posición de recuperaciones a partir de totales."
  },
  "dimensions": [
    {
      "id": "posesion",
      "label": "Posesión",
      "source": "possession",
      "method": "porcentaje registrado"
    },
    {
      "id": "pases",
      "label": "Precisión de pases",
      "source": "passAccuracy",
      "method": "porcentaje registrado"
    },
    {
      "id": "finalizacion",
      "label": "Precisión de tiros",
      "source": "shotAccuracy",
      "method": "porcentaje registrado"
    },
    {
      "id": "entradas",
      "label": "Intensidad en entradas",
      "source": "tackles",
      "method": "participación relativa de entradas contra el rival (no equivale a presión alta)"
    },
    {
      "id": "recuperaciones",
      "label": "Recuperaciones",
      "source": "recoveries",
      "method": "participación relativa de recuperaciones contra el rival"
    },
    {
      "id": "progresion",
      "label": "Rupturas de línea",
      "source": "lineBreakAttempts",
      "method": "participación relativa de intentos de ruptura contra el rival"
    }
  ],
